<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <!-- C# в браузере: Roslyn компилирует код ученика в памяти и запускает его. Собирается build.sh в public/runtimes/cs. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- код ученика может звать что угодно из BCL: фреймворк не обрезаем -->
    <PublishTrimmed>false</PublishTrimmed>
    <RunAOTCompilation>false</RunAOTCompilation>
    <!-- нормальные тексты исключений вместо ключей вида Arg_NullReferenceException -->
    <UseSystemResourceKeys>false</UseSystemResourceKeys>
    <!-- русская культура (числа, даты) и русские сообщения компилятора -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <WasmIncludeFullIcuData>true</WasmIncludeFullIcuData>
    <SatelliteResourceLanguages>ru</SatelliteResourceLanguages>
    <WasmEnableThreads>false</WasmEnableThreads>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageReference Include="Basic.Reference.Assemblies.Net100" Version="1.8.13" />
  </ItemGroup>
</Project>
